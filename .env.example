# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/certificate_manager?schema=public"

# Authentication
AUTH_SECRET="change-this-to-a-random-32-char-secret-key"

# License signing (generate with: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem)
# For development, run: npm run db:seed to generate keys
LICENSE_PRIVATE_KEY=""
LICENSE_PUBLIC_KEY=""

# App Configuration
NEXT_PUBLIC_APP_NAME="Certificate Manager"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="923192012074"

# Offline grace period (days) - also configurable in admin
OFFLINE_GRACE_DAYS=7

# License token validity (hours)
LICENSE_VALIDITY_HOURS=168

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
